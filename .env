# ─────────────────────────────────────────────────────────────────────────────
# MangoChain — Deployment Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# MODO 1 — Tudo num único PC:
#   Altere todos os NODE*_HOST para os nomes Docker (node0, node1, node2, node3)
#   e corra: docker compose up --build -d
#
# MODO 2 — 2 PCs na LAN (configuração actual):
#   PC1 (192.168.100.64): docker compose -f docker-compose.pc1.yml up --build -d
#   PC2 (192.168.100.8):  docker compose -f docker-compose.pc2.yml up --build -d
#   No PC2 altere ABCI_API_URL para http://192.168.100.64:8080
# ─────────────────────────────────────────────────────────────────────────────

NODE0_HOST=192.168.100.64
NODE1_HOST=192.168.100.64
NODE2_HOST=192.168.100.8
NODE3_HOST=192.168.100.8

NODE0_RPC_PORT=26657
NODE1_RPC_PORT=26667
NODE2_RPC_PORT=26657
NODE3_RPC_PORT=26667

# PC1: http://abci-app-0:8080
# PC2: http://192.168.100.64:8080
ABCI_API_URL=http://abci-app-0:8080
